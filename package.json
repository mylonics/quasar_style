{
  "name": "quasar-app-extension-primevue-aura",
  "version": "0.1.0",
  "description": "Quasar App Extension that restyles Quasar components to match the PrimeVue v4 Aura theme.",
  "license": "MIT",
  "author": "Mylonics",
  "repository": {
    "type": "git",
    "url": "https://github.com/mylonics/quasar_style.git"
  },
  "homepage": "https://github.com/mylonics/quasar_style#readme",
  "bugs": {
    "url": "https://github.com/mylonics/quasar_style/issues"
  },
  "keywords": [
    "quasar",
    "quasar-app-extension",
    "primevue",
    "aura",
    "theme",
    "vue"
  ],
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "generate:tokens": "node tools/generate-tokens.mjs",
    "build:css": "npm run build:css:aura && npm run build:css:material && npm run build:css:lara && npm run build:css:nora",
    "build:css:aura": "sass --no-source-map src/css/primevue-aura.scss dist/primevue-aura.css",
    "build:css:material": "sass --no-source-map src/css/primevue-material.scss dist/primevue-material.css",
    "build:css:lara": "sass --no-source-map src/css/primevue-lara.scss dist/primevue-lara.css",
    "build:css:nora": "sass --no-source-map src/css/primevue-nora.scss dist/primevue-nora.css",
    "playground": "node tools/build-playground.mjs",
    "screenshots": "node tools/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">= 18"
  },
  "peerDependencies": {
    "quasar": ">=2.0.0 <4.0.0"
  },
  "devDependencies": {
    "@primeuix/styled": "^0.7.0",
    "@primeuix/themes": "^2.0.0",
    "@primeuix/utils": "^0.6.0",
    "@quasar/extras": "^1.18.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "chart.js": "^4.5.1",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "quasar": "^2.16.0",
    "sass": "^1.70.0",
    "vitest": "^4.1.7",
    "vue": "^3.4.0"
  }
}
